<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.Region?>

<BorderPane fx:id="mainPane" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ucop.dinh_admin.controller.DashboardController">
   <top>
      <Label text="DASHBOARD - QUẢN LÝ TỔNG HỢP" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
         <padding>
            <Insets bottom="20.0" top="20.0" />
         </padding>
      </Label>
   </top>
   <left>
      <VBox spacing="15.0" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="MENU CHỨC NĂNG" textFill="#7f8c8d">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            
            <Button fx:id="btnUser" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#showUserMgmt" prefWidth="200.0" text="👤 Quản lý Người dùng (Admin)" />
            
            <Button fx:id="btnAudit" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#showAuditLog" prefWidth="200.0" text="🕒 Nhật ký Hoạt động" />
            
            <Button fx:id="btnCategory" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#showCategory" prefWidth="200.0" text="🗂️ Quản lý Danh mục" />
            
            <Button fx:id="btnProduct" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#showCatalog" prefWidth="200.0" text="📦 Quản lý Kho &amp; Sản phẩm" />
            
            <Button fx:id="btnCart" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#showOrder" prefWidth="200.0" text="🛒 Giỏ hàng" />
			
            <Button fx:id="btnOrder" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#showOrderList" prefWidth="200.0" text="📜 Danh sách Đơn hàng" />
            
            <Button fx:id="btnPayment" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#showPayment" prefWidth="200.0" text="💳 Thanh toán &amp; Ví" />
            
            <Button fx:id="btnReport" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#showReport" prefWidth="200.0" text="📊 Báo cáo &amp; Thống kê" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button fx:id="btnShipment" mnemonicParsing="false" onAction="#showShipment" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="🚚 Quản lý Vận chuyển" />
            
            <Button mnemonicParsing="false" onAction="#handleChangePassword" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #9b59b6; -fx-text-fill: white;" text="🔐 Đổi mật khẩu" />
            
            <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Đăng xuất" />
         </children>
      </VBox>
   </left>
   <center>
      <Label fx:id="lblWelcome" text="Chào mừng trở lại! Hãy chọn chức năng bên trái." textFill="#95a5a6" BorderPane.alignment="CENTER">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
   </center>
</BorderPane>